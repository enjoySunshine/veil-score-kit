{
  "name": "@colyseus/drizzle-driver",
  "version": "0.18.4",
  "type": "module",
  "input": "./src/index.ts",
  "main": "./build/index.cjs",
  "module": "./src/index.ts",
  "typings": "./build/index.d.ts",
  "exports": {
    ".": {
      "@source": "./src/index.ts",
      "types": "./build/index.d.ts",
      "module-sync": "./build/index.mjs",
      "import": "./build/index.mjs",
      "require": "./build/index.cjs"
    },
    "./*": {
      "@source": "./src/*.ts",
      "types": "./build/*.d.ts",
      "module-sync": "./build/*.mjs",
      "import": "./build/*.mjs",
      "require": "./build/*.cjs"
    }
  },
  "dependencies": {
    "@colyseus/core": "workspace:0.18.x",
    "drizzle-orm": "^0.38.4",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.6"
  },
  "peerDependencies": {
    "drizzle-kit": "^0.30.6",
    "drizzle-orm": "^0.38.4"
  },
  "license": "MIT",
  "keywords": [
    "colyseus",
    "matchmaking",
    "driver",
    "drizzle"
  ],
  "files": [
    "build",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">= 22.x"
  }
}
