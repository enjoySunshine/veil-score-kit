{
  "private": true,
  "name": "@colyseus/legacy-schema-serializer",
  "version": "0.18.1",
  "type": "module",
  "input": "./src/index.ts",
  "main": "./build/index.cjs",
  "module": "./src/index.ts",
  "typings": "./build/index.d.ts",
  "exports": {
    ".": {
      "@source": "./src/index.ts",
      "types": "./build/index.d.ts",
      "import": "./build/index.mjs",
      "require": "./build/index.cjs"
    },
    "./*": {
      "@source": "./src/*.ts",
      "types": "./build/*.d.ts",
      "import": "./build/*.mjs",
      "require": "./build/*.cjs"
    }
  },
  "dependencies": {
    "@colyseus/core": "workspace:^",
    "@colyseus/schema": "^5.0.6"
  },
  "license": "MIT",
  "files": [
    "build",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "320a0325f01eff3cd7afa8fb2efa80077ebdbf4a"
}
